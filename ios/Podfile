# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    { paths: [process.argv[1]] },
  )', __dir__]).strip

platform :ios, '15.5'

prepare_react_native_project!

# 🚨 REQUIRED for Google MLKit and vision-camera-face-detector
use_frameworks! :linkage => :static

target 'facesense' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Explicit dependencies to resolve undefined symbols
  pod 'GoogleMLKit/FaceDetection', '8.0.0'
  pod 'GoogleUtilities'
  pod 'GoogleDataTransport'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # 1. Force all pods to match your project's iOS 15.5 version
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

        # 2. Exclude arm64 for simulator to fix the "found arm64 required x86_64" error
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"

        # 3. Standard linking fixes
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)', '-ObjC', '-lc++']
      end
    end
  end
end